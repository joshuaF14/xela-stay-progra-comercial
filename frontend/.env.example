# Variables de Vite (se incrustan en el JavaScript al compilar: no poner secretos aquí).
# Copiar a frontend/.env para desarrollo local. En Render se configuran en el Static Site.
VITE_API_URL=http://localhost:8080
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable/anon key de Supabase (pública por diseño; el backend valida el JWT y RLS protege las tablas).
VITE_SUPABASE_ANON_KEY=<publishable-o-anon-key>
