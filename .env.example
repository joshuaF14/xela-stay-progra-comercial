# Plantilla sin credenciales. Copiar a .env (ignorado por Git) y completar valores reales solo en local.
# Nunca subir valores reales a este archivo.

# Backend (Spring Boot)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
# Orígenes permitidos para CORS, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base de datos (Supabase PostgreSQL)
DB_URL=jdbc:postgresql://<host>:<puerto>/postgres?sslmode=require
DB_USERNAME=<usuario>
DB_PASSWORD=<password>

# Flyway: mantener en false salvo ejecución aprobada
FLYWAY_ENABLED=false

# Frontend (Vite)
VITE_API_URL=http://localhost:8080
