# Plantilla sin credenciales. Copiar a .env (ignorado por Git) y completar valores reales solo en local.
# Nunca subir valores reales a este archivo.

# Backend (Spring Boot)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
# Orígenes permitidos para CORS, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base de datos (Supabase PostgreSQL)
DB_URL=jdbc:postgresql://<host>:<puerto>/postgres?sslmode=require
DB_USERNAME=<usuario>
DB_PASSWORD=<password>
# Opcional. Conexiones por backend (el Session pooler admite 15 en total para todo el equipo). Por defecto 3.
DB_POOL_SIZE=3

# Supabase Auth: validación del JWT en el backend (no son secretos, pero dependen del proyecto)
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# RabbitMQ (docker-compose.yml y backend). Usuario y contraseña locales, elegidos por cada integrante.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=<usuario>
RABBITMQ_PASSWORD=<password>
# En local: / y false. En CloudAMQP: el virtual host que indica la instancia, RABBITMQ_PORT=5671 y RABBITMQ_SSL=true.
RABBITMQ_VHOST=/
RABBITMQ_SSL=false
# Publicación y consumo de eventos. false si no tienes RabbitMQ corriendo (los eventos quedan pendientes).
EVENTS_ENABLED=true

# Agente de IA (Gemini). Key de Google AI Studio; cada integrante usa la suya y nunca se sube.
AI_API_KEY=<api-key-de-google-ai-studio>
# Modelo con plan gratuito. Alternativa con más cuota: gemini-3.5-flash-lite
AI_MODEL=gemini-3.8-flash

# Flyway: mantener en false salvo ejecución aprobada
FLYWAY_ENABLED=false

# Frontend (Vite)
VITE_API_URL=http://localhost:8080
